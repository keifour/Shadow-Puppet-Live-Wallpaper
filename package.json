{
  "name": "shadow-puppet-live-wallpaper",
  "version": "0.1.0",
  "description": "本地摄像头驱动的赛博水墨皮影桌面",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/renderer.js",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:win:zip": "electron-builder --win zip --x64 --config.win.signAndEditExecutable=false"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "studio.shadowpuppet.desktop",
    "productName": "Shadow Puppet",
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "scripts/wallpaper.ps1",
        "to": "wallpaper.ps1"
      }
    ]
  }
}
